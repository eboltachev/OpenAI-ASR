# Upstream OpenAI-compatible ASR endpoint (for example, vLLM).
OPENAI_API_KEY=local-token
OPENAI_BASE_URL=http://host.docker.internal:8001/v1
API_PORT=8000
PUID=1000
PGID=1000

# Required when models are downloaded from gated Hugging Face repositories.
HF_TOKEN=

# Optional bearer token protecting this service. Empty means authentication is disabled.
SERVICE_API_KEY=

DEFAULT_ASR_MODEL=openai/whisper-large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
SPEAKER_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# A value may be a Hugging Face model id or a local path below /app/models.
ALIGNMENT_MODEL_RU=jonatasgrosman/wav2vec2-large-xlsr-53-russian
ALIGNMENT_MODEL_UZ=lucio/xls-r-uzbek-cv8
ALIGNMENT_REQUIRED=false

MODEL_DEVICE=cuda
PRELOAD_MODELS=true
LOCAL_PIPELINE_CONCURRENCY=1
ASR_CONCURRENCY=8
ASYNC_JOB_WORKERS=1

MAX_UPLOAD_MB=250
UPSTREAM_TIMEOUT_SECONDS=600
SAME_SPEAKER_MERGE_GAP_SECONDS=1.0
SEGMENT_PADDING_SECONDS=0.25
MIN_EMBEDDING_SEGMENT_SECONDS=1.5
MAX_EMBEDDING_SEGMENT_SECONDS=5.0
MAX_EMBEDDING_OVERLAP_RATIO=0.05
EMBEDDING_SIMILARITY_FLOOR=0.45

LOG_LEVEL=INFO
LOG_FILE=/app/logs/openai-asr.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
